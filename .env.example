# ---- Sailor server (never expose these to the browser) --------------------
DATABASE_URL=
# Generate each secret independently with: openssl rand -base64 32
BETTER_AUTH_SECRET=
SAILOR_ENCRYPTION_KEY=

# ---- User login (Google + GitHub OAuth only) -------------------------------
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# Local URLs and ports have working defaults. Set these only when deployed:
# WEB_ORIGIN=https://sailor.example.com
# API_PUBLIC_URL=https://api.sailor.example.com
# NEXT_PUBLIC_API_URL=https://api.sailor.example.com
