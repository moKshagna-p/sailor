# ---- Core ----
DATABASE_URL=postgres://sailor:sailor@localhost:5432/sailor
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# ---- Model providers -------------------------------------------------------
# You need AT LEAST ONE. Every provider supports an API key; Anthropic, OpenAI
# and Google additionally support OAuth (subscription) credentials, which are
# stored per-user in the DB and refreshed automatically. See @docs/providers.md
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# OAuth apps (only needed if you enable subscription sign-in for that provider)
ANTHROPIC_OAUTH_CLIENT_ID=
OPENAI_OAUTH_CLIENT_ID=
OPENAI_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Web research tool -----------------------------------------------------
# Used by the agent's web_search / fetch_url tools to verify job descriptions
# and company facts. Exa preferred; Brave is the fallback.
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=

# ---- LaTeX ----
# Path to the tectonic binary. `bun run scripts/install-tectonic.ts` fetches it.
TECTONIC_BIN=./bin/tectonic
TECTONIC_CACHE_DIR=./.tectonic-cache
LATEX_POOL_SIZE=4
LATEX_TIMEOUT_MS=20000
SAILOR_ENCRYPTION_KEY=<generated>
