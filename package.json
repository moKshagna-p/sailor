{
  "name": "sailor",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter @sailor/web dev",
    "dev:api": "bun run --filter @sailor/api dev",
    "build": "bun run --filter '*' build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "db:generate": "bun run --filter @sailor/db generate",
    "db:migrate": "bun run --filter @sailor/db migrate",
    "db:studio": "bun run --filter @sailor/db studio",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "mcp": "bun run --filter @sailor/agent mcp",
    "setup": "bun install && bun run db:up && sleep 2 && bun run db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "^1.3.14",
    "typescript": "5.9.3"
  }
}
